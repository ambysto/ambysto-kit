<Project Sdk="Microsoft.NET.Sdk">
  <!-- MSTest (Microsoft's own), test project only (APS-23 decision). The acceptance tests of plan group 3: the contract
       docs/spec/safety.md and the intent's criteria, written before the implementation. Fixtures are real files, real
       registry values of the test user and the test cloud provider; every setting a test changes is restored. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Ambysto.Kit.Safety.Tests</RootNamespace>
    <!-- Test-side P/Invoke (LibraryImport) for fixtures: reparse points, subst, mapped drives, the Recycle Bin. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.4.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Ambysto.Kit.Safety/Ambysto.Kit.Safety.csproj" />
    <!-- Build-only: whoever builds the tests (the gates in Release, Stryker.NET in Debug) builds the cloud fixture in the
         same configuration, at the one exact path CloudRoot.FindExe expects. Without this, Stryker's Debug build had no
         fixture, every CloudTest failed in its initial run and was excluded (0 covered, 0 killed). -->
    <ProjectReference Include="../Ambysto.Kit.Safety.CloudFixture/Ambysto.Kit.Safety.CloudFixture.csproj"
                      ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline license keys, format 1: docs/spec/license.md. No package references: the runtime only. -->
  <PropertyGroup>
    <AssemblyName>Ambysto.Kit.License</AssemblyName>
    <RootNamespace>Ambysto.Kit.Licensing</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <PropertyGroup>
    <!-- The real version comes only from a windows-vX.Y.Z tag (-p:Version in .github/workflows/windows-release.yml). -->
    <Version>0.0.0-dev</Version>
    <PackageId>Ambysto.Kit.License</PackageId>
    <Authors>Ambysto</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Description>Offline verification of Ambysto license keys (format 1): AMB- key texts and .ambystokey files, ECDSA P-256, no network.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/ambysto/ambysto-kit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- GitHub's NuGet registry takes no .snupkg symbol packages: the symbols travel inside the one .nupkg. -->
    <DebugType>embedded</DebugType>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Ambysto.Kit.License.Tests" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
